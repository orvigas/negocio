# Dependencias
node_modules/

# Variables de entorno (usar .env.example como plantilla)
.env
.env.*
!.env.example

# Build de CSS (generado por Tailwind desde src/styles/)
public/css/*
!public/css/.gitkeep

# Datos locales (DATA_DIR por defecto fuera de producción)
data/

# Logs y cobertura
*.log
npm-debug.log*
coverage/

# Sistema / editores
.DS_Store
.vscode/
.idea/

Imagenes/

# Hoja de cálculo de trabajo del usuario (cotizador de taquizas): se queda en local, no se versiona.
/Cotizador_Taquiza_Birria.xlsx

# Datos reales del negocio (REQ-F-050, A5): ninguna hoja de cálculo ni el JSON de importación real
# entran al repositorio. `npm run lint` (scripts/check-private-data.ts) lo comprueba también en el CI.
*.xlsx
*.xlsm
*.xls
*.ods
~$*
/datos-privados/
