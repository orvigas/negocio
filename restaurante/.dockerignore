# Contexto de build de Docker (REQ-F-003): restaurante/, la raíz de los workspaces (REQ-F-036 y
# REQ-F-037: landing-pages/, con el Dockerfile, y packages/). Nada de secretos, datos editables ni
# artefactos locales: la imagen instala sus dependencias y compila su CSS.

# Dependencias (se instalan con npm ci dentro de la imagen)
node_modules
**/node_modules

# Variables de entorno: la configuración se inyecta al ejecutar, nunca en el build
.env
**/.env
.env.*
**/.env.*
!.env.example

# Datos editables de la administración (DATA_DIR por defecto fuera de producción)
data
landing-pages/data

# Cliente de Prisma generado localmente (la etapa build lo genera; REQ-F-037)
packages/db/src/generated

# CSS generado localmente (la etapa build lo compila); se conserva public/css/.gitkeep
landing-pages/public/css/*/
inventory-manager/public/css/main.css

# Logs y cobertura
coverage
*.log
npm-debug.log*

# Git
.git
.gitignore

# Sistema / editores
.DS_Store
**/.DS_Store
Thumbs.db
.vscode
.idea
*.swp

# Archivos de Docker (no los necesita la imagen)
landing-pages/Dockerfile
compose.yaml
.dockerignore
docker

# Lo compartido del monorepo que ninguna imagen usa: despliegue (REQ-F-016), respaldos del host
# (REQ-F-019), excepciones de la auditoría (REQ-F-020) y documentación
deploy
ops
security
docs
