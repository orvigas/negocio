# Común a todo el monorepo (REQ-F-036). Lo propio de cada workspace va en su .gitignore.

# Dependencias (npm workspaces: se instalan en la raíz y, si hace falta, en cada workspace)
node_modules/

# Variables de entorno (plantillas: landing-pages/.env.example y packages/db/.env.example)
.env
.env.*
!.env.example

# Logs y cobertura
*.log
npm-debug.log*
coverage/

# Sistema / editores
.DS_Store
.vscode/
.idea/
