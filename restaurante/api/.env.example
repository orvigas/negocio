# Variables de la API (REQ-F-038). Copia este archivo a api/.env para desarrollo local
# (npm run dev:api o npm run dev desde restaurante/). El .env real no se versiona.

# development | test | production (obligatoria; `npm run dev:api` la fija en development).
NODE_ENV=development

# Dirección IP literal y puerto de escucha. Por defecto, 127.0.0.1:3001 (solo esta máquina).
# En Docker la imagen usa HOST=0.0.0.0 y PORT=3001, alcanzable solo desde la red interna.
HOST=127.0.0.1
PORT=3001

# MySQL con el usuario solo DML de la app (el mismo DATABASE_URL que landing-pages/.env; REQ-F-038
# no crea un usuario de solo lectura). La API solo lee: no migra, no importa semillas ni escribe.
DATABASE_URL=mysql://restaurante_app:app-dev@127.0.0.1:3307/restaurante
