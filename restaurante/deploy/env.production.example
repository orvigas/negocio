# Plantilla de /opt/restaurante/.env en el VPS (REQ-F-016). Cópiala, rellena los valores y deja el
# archivo con permisos 600 y dueño deploy (deploy.sh se niega a desplegar si no). Es el ÚNICO lugar
# con los secretos de la app: nunca lo subas al repositorio ni lo copies a GitHub.
#
#   sudo install -o deploy -g deploy -m 600 env.production.example /opt/restaurante/.env
#
# Escribe los valores sin comillas, salvo ADMIN_PASSWORD_HASH (entre comillas simples: lleva "$").
# La app recibe solo las variables que lista deploy/compose.prod.yaml; NODE_ENV, HOST, PORT,
# TRUST_PROXY, DATA_DIR y DATABASE_URL los fija el propio compose. Una variable nueva de la app
# exige añadirla al compose y reinstalar deploy/.
# NUNCA definas aquí DATABASE_ALLOW_NEWER_SCHEMA: solo la usa la vuelta atrás automática.

# --- Infraestructura -----------------------------------------------------------------------------
# Dominio raíz (sin www). www.<dominio> redirige a él.
RESTAURANTE_DOMAIN=birriaelmuneco.com
# Registro de las imágenes (restaurante y restaurante-migrate).
RESTAURANTE_REGISTRY=ghcr.io/orvigas
# Nombre del certresolver y de los entrypoints del Traefik existente (CA-11).
TRAEFIK_CERTRESOLVER=letsencrypt
TRAEFIK_ENTRYPOINT_HTTP=web
TRAEFIK_ENTRYPOINT_HTTPS=websecure
# IP en la que deploy.sh llega a Traefik por el puerto 443 para la comprobación de salud.
RESTAURANTE_PROBE_ADDRESS=127.0.0.1

# --- MySQL ---------------------------------------------------------------------------------------
# Genera cada una con: openssl rand -hex 32 (hexadecimal en minúsculas, obligatorio).
# Solo se aplican al crear el volumen de MySQL (primer despliegue); cambiarlas después exige
# ALTER USER en MySQL además de aquí.
MYSQL_ROOT_PASSWORD=
RESTAURANTE_DB_APP_PASSWORD=
RESTAURANTE_DB_MIGRATOR_PASSWORD=
RESTAURANTE_DB_BACKUP_PASSWORD=

# --- App -----------------------------------------------------------------------------------------
BUSINESS_TIMEZONE=America/Mexico_City
SITE_URL=https://birriaelmuneco.com

# Con el bot, los dos llevan el número del bot (el mismo). Formato: solo dígitos, internacional.
WHATSAPP_MOLOTES=
WHATSAPP_MOLOTES_URL=
WHATSAPP_MOLOTES_MESSAGE=Hola, quiero hacer un pedido de molotes
WHATSAPP_BIRRIA=
WHATSAPP_BIRRIA_URL=
WHATSAPP_BIRRIA_MESSAGE=Hola, quiero hacer un pedido de birria

# Bot de WhatsApp: siempre meta en producción (ver .env.example para cada variable).
WHATSAPP_BOT_PROVIDER=
WHATSAPP_BOT_ACCOUNT_ID=
WHATSAPP_BOT_ACCESS_TOKEN=
WHATSAPP_BOT_STAFF_MOLOTES=
WHATSAPP_BOT_STAFF_BIRRIA=
WHATSAPP_BOT_STAFF_TEMPLATE=
WHATSAPP_BOT_APP_SECRET=
WHATSAPP_BOT_VERIFY_TOKEN=
WHATSAPP_BOT_STAFF_TEMPLATE_LANGUAGE=
WHATSAPP_GRAPH_API_VERSION=

# Primer administrador (solo se usa si la base no tiene usuarios). Hash con npm run admin:hash-password.
ADMIN_USER=
ADMIN_PASSWORD_HASH=''
