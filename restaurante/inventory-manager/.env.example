# Variables del admin nuevo (REQ-F-039). Copia este archivo a inventory-manager/.env para desarrollo
# local (npm run dev:inventory o npm run dev desde restaurante/). El .env real no se versiona.

# development | test | production (obligatoria; `npm run dev:inventory` la fija en development).
NODE_ENV=development

# Dirección IP literal y puerto de escucha. Por defecto, 127.0.0.1:3003.
HOST=127.0.0.1
PORT=3003

# Base de la API propia (api/.env, puerto 3001). En producción, http://api:3001 por la red interna.
API_INTERNAL_URL=http://127.0.0.1:3001

# true detrás de un proxy con TLS (Traefik en producción): HTTPS y la IP real del visitante salen
# de X-Forwarded-Proto y X-Forwarded-For (solo el último valor). false en desarrollo.
TRUST_PROXY=false
