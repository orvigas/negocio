# Copia este archivo como .env y ajusta los valores. No subas .env al repositorio.
# `npm start` y `npm run dev` cargan .env automáticamente si existe.
# La app no arranca si algún valor es inválido (muestra la lista de problemas).

# --- Servidor ---
# Obligatoria: development | production | test. Sin ella la app no arranca.
# `npm run dev` siempre usa development (ignora este valor); `npm start` lo toma de aquí o del
# entorno (en producción: NODE_ENV=production).
NODE_ENV=development
# Dirección IP en la que escucha el servidor (por defecto: 127.0.0.1, solo esta máquina).
# Solo IP literales IPv4 o IPv6: localhost no es válido (usa 127.0.0.1 o ::1). Para aceptar
# conexiones de otros equipos (p. ej. probar desde el móvil en tu red local) usa 0.0.0.0 o ::.
# La imagen Docker de producción ya fija 0.0.0.0 dentro del contenedor.
# HOST=127.0.0.1
# Entero 1-65535 (por defecto: 3000)
PORT=3000

# --- Fecha y zona horaria del negocio ---
# Zona horaria IANA usada para decidir qué landing mostrar (L-V Molotes, S-D Birria).
# Se usa BUSINESS_TIMEZONE en lugar de TZ para no alterar la zona horaria del proceso Node.
# Por defecto: America/Mexico_City
BUSINESS_TIMEZONE=America/Mexico_City

# --- SEO ---
# URL pública opcional del sitio (http/https, sin query ni fragmento). Si se define, la
# URL canónica, og:url y og:image son absolutas (p. ej. https://moloteando.mx/molotes).
# Si se omite, la canónica es relativa (/molotes, /birria) y no se emiten og:url/og:image.
SITE_URL=

# --- WhatsApp ---
# Para cada negocio define *_URL o el número (al menos uno es obligatorio).
#  - *_URL: enlace completo del bot (solo https). Si está definida, tiene prioridad.
#  - Número: formato internacional, solo dígitos, sin "+" ni espacios (8 a 15). Ej: 5215512345678
#    Con el número se construye https://wa.me/<número>?text=<mensaje codificado>.
#  - *_MESSAGE: mensaje inicial opcional (máx. 500 caracteres); solo se usa con el número.

# Molotes
WHATSAPP_MOLOTES_URL=
WHATSAPP_MOLOTES=
WHATSAPP_MOLOTES_MESSAGE=Hola, quiero hacer un pedido de molotes

# Birria El Muñeco
WHATSAPP_BIRRIA_URL=
WHATSAPP_BIRRIA=
WHATSAPP_BIRRIA_MESSAGE=Hola, quiero hacer un pedido de birria

# --- Bot de WhatsApp (REQ-F-009, REQ-F-012) ---
# Un solo bot para los dos negocios (webhook /webhooks/whatsapp), con uno de dos proveedores:
#  - meta:   WhatsApp Cloud API de Meta. Es el proveedor de PRODUCCIÓN.
#  - twilio: API de WhatsApp de Twilio (incluido el sandbox). Solo para DESARROLLO: con
#            NODE_ENV=production y WHATSAPP_BOT_PROVIDER=twilio la app no arranca.
# Prerrequisitos, registro del webhook y plantillas de cada proveedor: README, "Bot de WhatsApp".
#
# Habilitar: el bot queda habilitado si defines al menos una variable de datos del bot (todas las
# de abajo salvo WHATSAPP_BOT_PROVIDER, que no lo habilita por sí sola). Sin ninguna, queda
# deshabilitado (el webhook responde 503 y las landings siguen igual). Habilitado, el proveedor
# y sus obligatorias deben estar y ser válidas o la app no arranca (lista los problemas sin
# mostrar valores). Las variables que solo usa el otro proveedor se ignoran.
# Con el bot, WHATSAPP_MOLOTES y WHATSAPP_BIRRIA (arriba) llevan el número del bot (el mismo).
# Con twilio, WHATSAPP_MOLOTES también es el número emisor (en el sandbox, 14155238886).
#
# Renombrada: WHATSAPP_BOT_PHONE_NUMBER_ID ahora es WHATSAPP_BOT_ACCOUNT_ID (sin compatibilidad:
# si la anterior sigue definida, la app no arranca y pide renombrarla).
#
# Proveedor: meta o twilio (sin distinguir mayúsculas). Obligatorio con el bot habilitado.
WHATSAPP_BOT_PROVIDER=
# Datos de la cuenta (los dos proveedores usan los mismos nombres):
#  - meta:   ID del número del bot en la Cloud API (no es el número de teléfono). Solo dígitos.
#  - twilio: Account SID (AC seguido de 32 caracteres hexadecimales).
WHATSAPP_BOT_ACCOUNT_ID=
#  - meta:   token de acceso permanente de un usuario del sistema (secreto).
#  - twilio: Auth Token (secreto): autentica los envíos y firma el webhook (X-Twilio-Signature).
WHATSAPP_BOT_ACCESS_TOKEN=
# Número de WhatsApp del personal de cada negocio (los dos proveedores): recibe los pedidos
# confirmados y es el contacto directo que el bot da al cliente ("persona"). Solo dígitos,
# formato internacional. Con el sandbox de Twilio, estos teléfonos deben unirse al sandbox.
WHATSAPP_BOT_STAFF_MOLOTES=
WHATSAPP_BOT_STAFF_BIRRIA=
# Aviso al personal:
#  - meta:   obligatoria. Nombre de la plantilla aprobada (categoría Utility).
#  - twilio: opcional. ContentSid (HX...) de un Content Template; sin ella, el aviso va como
#            texto libre (el sandbox no admite plantillas propias).
WHATSAPP_BOT_STAFF_TEMPLATE=
# Solo meta (con twilio se ignoran):
# Secreto de la app de Meta (App Secret): valida la firma X-Hub-Signature-256 (secreto).
WHATSAPP_BOT_APP_SECRET=
# Token de verificación que registras en Meta junto con la URL del webhook (secreto, 16 a 128
# caracteres: letras, dígitos y . _ ~ -). Genéralo con: openssl rand -hex 32
WHATSAPP_BOT_VERIFY_TOKEN=
# Opcionales: idioma de la plantilla (por defecto es_MX) y versión de la Graph API (por defecto v26.0).
WHATSAPP_BOT_STAFF_TEMPLATE_LANGUAGE=
WHATSAPP_GRAPH_API_VERSION=
# Solo twilio (con meta se ignora; obligatoria con twilio):
# URL pública https COMPLETA del webhook, exactamente la configurada en Twilio ("When a message
# comes in"), terminada en /webhooks/whatsapp y sin query (p. ej. la del túnel HTTPS). La firma
# se calcula con ella: si no coincide, el webhook responde 403. También es el StatusCallback.
WHATSAPP_BOT_WEBHOOK_URL=

# --- Protección del bot: topes de gasto, lista negra e interruptor (REQ-F-025) ---
# Clave del identificador seudonimizado de la lista negra (secreta). OBLIGATORIA con el bot
# habilitado; sin bot se ignora y no lo habilita. Al menos 32 bytes aleatorios en base64,
# base64url o hexadecimal: openssl rand -base64 32. Guárdala en el gestor de contraseñas:
# si se pierde o se cambia sin rotarla, la lista negra deja de reconocer los números.
WHATSAPP_BOT_BLOCKLIST_KEY=
# Solo durante una rotación: la clave anterior (la página "Bot" de /admin indica cuándo quitarla).
WHATSAPP_BOT_BLOCKLIST_KEY_PREVIOUS=
# Umbrales (vacíos = valor por defecto entre paréntesis). Un valor inválido impide arrancar.
# Por número de cliente y día (en memoria; un reinicio los pone a cero):
# Pedidos confirmados (3)
BOT_LIMIT_ORDERS_PER_NUMBER_DAY=
# Mensajes procesados (60); al pasarlo, bloqueo automático
BOT_LIMIT_MESSAGES_PER_NUMBER_DAY=
# Mensajes por minuto (20)
BOT_LIMIT_MESSAGES_PER_MINUTE=
# Ráfaga: como mucho BOT_LIMIT_BURST mensajes (5) cada BOT_LIMIT_BURST_WINDOW_SECONDS segundos (10)
BOT_LIMIT_BURST=
BOT_LIMIT_BURST_WINDOW_SECONDS=
# Globales (en MySQL; sobreviven a un reinicio):
# Avisos al personal por día (60)
BOT_LIMIT_TEMPLATES_DAY=
# Avisos al personal por mes (1500)
BOT_LIMIT_TEMPLATES_MONTH=
# Mensajes del bot al cliente por día (800)
BOT_LIMIT_OUTBOUND_DAY=
# Mensajes del bot al cliente por mes (12000)
BOT_LIMIT_OUTBOUND_MONTH=
# Presupuesto mensual estimado en USD (20)
BOT_BUDGET_MONTH_USD=
# Tarifa de la plantilla utility (0.0085)
BOT_COST_UTILITY_USD=
# Tarifa de un mensaje de servicio (0.0085)
BOT_COST_SERVICE_USD=
# Mensajes de servicio gratis al mes (1000)
BOT_FREE_SERVICE_MONTH=
# Repetidos y lista negra:
# BOT_REPEAT_COUNT textos idénticos (5) en BOT_REPEAT_WINDOW_MINUTES minutos (10) dan un
# enfriamiento de BOT_COOLDOWN_MINUTES minutos (30)
BOT_REPEAT_COUNT=
BOT_REPEAT_WINDOW_MINUTES=
BOT_COOLDOWN_MINUTES=
# Bloqueo al pasar el tope diario de mensajes (7)
BOT_BLOCK_CAP_DAYS=
# Escalones del bloqueo por repeticiones (24,168,720)
BOT_BLOCK_REPEAT_STEPS_HOURS=
# Historial para el escalón y conservación de lo vencido (30)
BOT_BLOCK_HISTORY_DAYS=
# Conservación de la auditoría del bot (12)
BOT_AUDIT_RETENTION_MONTHS=
# Mensajes en proceso o en espera entre todos (100)
BOT_QUEUE_MAX=
# Refresco de la lista negra y del interruptor (10)
BOT_CONTROL_REFRESH_SECONDS=

# --- Base de datos MySQL 8.4 (REQ-F-014) ---
# API propia (REQ-F-038): las landings leen de ella los productos. Obligatoria en todos los
# entornos: URL http(s) sin usuario, contraseña, parámetros ni fragmento; ausente o inválida, la app
# no arranca. En local, la de `npm run dev:api` (api/.env, puerto 3001); en producción la fija
# deploy/compose.prod.yaml (http://api:3001, red interna). Sin la API en marcha, las landings
# sirven la semilla de content/seeds.ts hasta que responda.
API_INTERNAL_URL=http://127.0.0.1:3001

# Aviso interno de la API (REQ-F-039, RF-13): tras cada escritura de productos en el admin nuevo, la
# API avisa a este puerto (solo red interna; nunca el de PORT) para que la landing y el bot muestren
# el cambio al instante. Obligatoria en producción; sin INTERNAL_NOTIFY_TOKEN (en desarrollo) no se
# abre y queda la recarga de 60 s. El token es
# el mismo de api/.env (al menos 32 caracteres: openssl rand -hex 32).
# INTERNAL_PORT=3002
# INTERNAL_NOTIFY_TOKEN=

# URL del admin nuevo (inventory-manager, REQ-F-039, RF-15). Con ella, la edición de productos de
# /admin queda en solo lectura y enlaza ahí (https en producción). Sin ella, /admin edita como antes.
# ADMIN_NEW_URL=

# Usuarios de /admin, su auditoría y los productos de las landings (REQ-F-007, REQ-F-008).
# En utf8mb4 con la colación utf8mb4_es_0900_as_cs (español moderno: la ñ va después de la n;
# distingue acentos y mayúsculas) en la base, las tablas y las columnas.
#
# DATABASE_URL: conexión de la APP. Obligatoria en todos los entornos. Usuario solo de datos
# (SELECT, INSERT, UPDATE, DELETE): la app nunca modifica el esquema. Formato:
#   mysql://usuario:contraseña@host:puerto/base       (sin parámetros; puerto 3306 por defecto)
# Los caracteres especiales de usuario y contraseña van codificados como en una URL:
#   @ -> %40   : -> %3A   / -> %2F   % -> %25   # -> %23   ? -> %3F
# (p. ej. en node: encodeURIComponent('la-contraseña')). Es un secreto: nunca aparece en logs ni
# en errores. Al arrancar, la app verifica la base (conexión con reintentos hasta 60 s,
# credenciales, utf8mb4 y colación, modo estricto y migraciones al día); si algo falla, no arranca.
# Desarrollo con el MySQL local de compose.yaml (`npm run db:up`, solo en 127.0.0.1:3307):
DATABASE_URL=mysql://restaurante_app:app-dev@127.0.0.1:3307/restaurante
#
# MIGRATION_DATABASE_URL y SHADOW_DATABASE_URL (migraciones) no van aquí: la app no las lee. Están
# en packages/db/.env.example (REQ-F-037), que lee el CLI de Prisma.

# --- Datos editables (hero, texto destacado y promociones) ---
# Carpeta donde se guardan los JSON de página editables desde /admin (hero, texto destacado y
# promociones): <negocio>/current.json, <negocio>/previous.json (versión anterior),
# changes.jsonl (registro de cambios) y, si se dañan, damaged-<fecha>.json + damaged.marker.json.
# Si no existen, se crean desde la semilla versionada (src/content/<negocio>/seed.json). Sus
# listas de productos quedan "congeladas" (ya no se usan; permiten volver a una versión anterior).
# La primera vez, cada negocio importa sus productos a la base de datos UNA SOLA VEZ desde
# current.json (o previous.json, o la semilla). Los productos se gestionan en /admin y en la API
# JSON /admin/api (con sesión; ver README).
# Obligatoria en producción y como ruta absoluta (p. ej. /var/lib/restaurante). Fuera de
# producción, por defecto: la carpeta data/ del proyecto (ignorada por git).
# No puede estar dentro de src/ ni de public/. Haz respaldos de esta carpeta.
DATA_DIR=

# --- Primer administrador de /admin ---
# Cada persona entra con su propia cuenta (usuarios en la base de datos). Estas dos variables
# SOLO se usan en el primer arranque, cuando la base de datos no tiene usuarios: crean el primer
# administrador con este usuario y esta contraseña. Después se ignoran (el log avisa con
# admin_bootstrap_ignored, sin mostrar valores) y los usuarios se gestionan en /admin/usuarios.
# Sin usuarios y sin estas variables, /admin responde 503 y las landings siguen funcionando.
# Definir solo una de las dos, o un hash inválido, es un error de configuración.
# Si se pierde la contraseña del último administrador:
#   npm run admin:recover -- --usuario <nombre>
ADMIN_USER=
# Hash scrypt de la contraseña, NUNCA la contraseña en claro. Genéralo con:
#   npm run admin:hash-password
# (formato: scrypt$N$r$p$sal$hash). Mínimo 12 caracteres de contraseña.
# Escríbelo entre comillas simples: ADMIN_PASSWORD_HASH='scrypt$...'. Node lo lee igual y
# Docker Compose (que lee este .env para interpolar) no interpreta los "$" del hash.
ADMIN_PASSWORD_HASH=

# --- Proxy inverso ---
# true solo si la app está detrás de un proxy con TLS que reenvía X-Forwarded-Proto y
# X-Forwarded-For (en producción, Traefik: deploy/compose.prod.yaml ya la fija en true).
# En producción /admin solo funciona por HTTPS. Por defecto: false.
TRUST_PROXY=false

# --- Vuelta atrás del despliegue (REQ-F-016) ---
# DATABASE_ALLOW_NEWER_SCHEMA=true hace que la app arranque aunque la base tenga migraciones que su
# código no conoce (las conocidas siguen siendo obligatorias; registra
# database_newer_than_code_allowed). Solo la pone deploy/deploy.sh al volver a la versión anterior
# tras un despliegue fallido. No la definas en ningún .env. Por defecto: false.
# DATABASE_ALLOW_NEWER_SCHEMA=false
