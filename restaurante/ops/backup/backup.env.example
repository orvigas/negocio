# Configuración de los respaldos (REQ-F-019). En el VPS: /etc/restaurante-backup/backup.env
# (root:deploy, permisos 640). Sin comillas ni espacios. Nunca se versiona con valores.
# Pasos para obtener cada valor: docs/despliegue.md, "Respaldos fuera del VPS".

# Account ID de Cloudflare (32 caracteres hexadecimales).
R2_ACCOUNT_ID=
# Bucket privado con los bucket locks y el ciclo de vida configurados.
R2_BUCKET=restaurante-respaldos
# Token de R2 "Object Read & Write" limitado a ese bucket (Access Key ID y Secret Access Key).
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# URL de ping del check "respaldo diario" de Healthchecks.io (https://hc-ping.com/...). Es un secreto.
HC_PING_URL=
# Espacio libre mínimo en /opt/restaurante/offsite antes de empezar (MB).
BACKUP_MIN_FREE_MB=1024

# En el Mac (~/.config/restaurante-backup/r2-readonly.conf, permisos 600) van las mismas variables
# R2_*, con el token "Object Read only", y HC_PING_URL del check "prueba mensual" (opcional).
