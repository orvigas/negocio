# Respaldo diario cifrado fuera del VPS (REQ-F-019). Lo lanza restaurante-backup.timer.
# Instalación: docs/despliegue.md, "Respaldos fuera del VPS". A mano: sudo systemctl start restaurante-backup.service
[Unit]
Description=Respaldo cifrado de restaurante (MySQL y app-data) a Cloudflare R2
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
User=deploy
Group=deploy
ExecStart=/opt/restaurante/ops/backup/backup.sh
TimeoutStartSec=1h
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
ReadWritePaths=/opt/restaurante/offsite /opt/restaurante/state
