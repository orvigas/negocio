{
  "name": "restaurante",
  "version": "0.1.0",
  "private": true,
  "description": "Landing pages de Molotes (lunes a viernes) y Birria El Muñeco (sábado y domingo) servidas por una sola app Koa.",
  "type": "module",
  "main": "src/server.ts",
  "engines": {
    "node": ">=24.3.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.ts",
    "dev": "node --watch --env-file-if-exists=.env src/server.ts",
    "build:css": "npm run build:css:molotes && npm run build:css:birria && npm run build:css:admin",
    "build:css:molotes": "tailwindcss -i src/styles/molotes/main.css -o public/css/molotes/main.css --minify",
    "build:css:birria": "tailwindcss -i src/styles/birria/main.css -o public/css/birria/main.css --minify",
    "build:css:admin": "tailwindcss -i src/styles/admin/main.css -o public/css/admin/main.css --minify",
    "watch:css": "npm run watch:css:molotes & npm run watch:css:birria & npm run watch:css:admin & wait",
    "watch:css:molotes": "tailwindcss -i src/styles/molotes/main.css -o public/css/molotes/main.css --watch",
    "watch:css:birria": "tailwindcss -i src/styles/birria/main.css -o public/css/birria/main.css --watch",
    "watch:css:admin": "tailwindcss -i src/styles/admin/main.css -o public/css/admin/main.css --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json",
    "db:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "admin:hash-password": "node scripts/hash-password.ts",
    "admin:recover": "node --env-file-if-exists=.env scripts/admin-recover.ts",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0"
  },
  "dependencies": {
    "@koa/router": "^15.7.0",
    "@prisma/adapter-better-sqlite3": "7.10.0",
    "@prisma/client": "7.10.0",
    "better-sqlite3": "12.11.1",
    "helmet": "^8.3.0",
    "koa": "^3.2.1",
    "koa-helmet": "^9.0.0",
    "koa-static": "^5.0.0"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/forms": "^0.5.11",
    "@types/better-sqlite3": "9.6.0",
    "@types/jsdom": "^30.0.0",
    "@types/koa": "^3.0.3",
    "@types/koa-static": "^4.0.4",
    "@types/node": "^24.19.1",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.1",
    "prisma": "7.10.0",
    "supertest": "^7.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "prisma@7.10.0": true,
    "@prisma/engines@7.10.0": true,
    "@parcel/watcher": false,
    "fsevents": false
  }
}
