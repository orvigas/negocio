{
  "name": "restaurante",
  "version": "0.1.0",
  "private": true,
  "description": "Monorepo (npm workspaces) de Molotes y Birria El Muñeco. Workspace: landing-pages (app Koa con las landings, /admin y el bot de WhatsApp).",
  "engines": {
    "node": ">=24.22.1"
  },
  "workspaces": [
    "landing-pages"
  ],
  "scripts": {
    "start": "npm run start -w landing-pages --",
    "dev": "npm run dev -w landing-pages --",
    "build:css": "npm run build:css -w landing-pages --",
    "watch:css": "npm run watch:css -w landing-pages --",
    "test": "npm run test -w landing-pages --",
    "test:watch": "npm run test:watch -w landing-pages --",
    "typecheck": "npm run typecheck -w landing-pages --",
    "db:generate": "npm run db:generate -w landing-pages --",
    "db:up": "docker compose up -d --wait mysql-dev",
    "db:down": "docker compose stop mysql-dev",
    "db:migrate": "npm run db:migrate -w landing-pages --",
    "db:migrate:dev": "npm run db:migrate:dev -w landing-pages --",
    "admin:hash-password": "npm run admin:hash-password -w landing-pages --",
    "admin:recover": "npm run admin:recover -w landing-pages --",
    "bot:chat": "npm run bot:chat -w landing-pages --",
    "lint": "npm run lint -w landing-pages --",
    "lint:fix": "npm run lint:fix -w landing-pages --",
    "audit:deps": "npm run audit:deps -w landing-pages --"
  },
  "allowScripts": {
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true,
    "@parcel/watcher": false,
    "fsevents": false
  }
}
