{
  "name": "restaurante",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Monorepo (npm workspaces) de Molotes y Birria El Muñeco. Workspaces: packages/core (dominio), packages/contracts (contratos de la API), packages/db (Prisma y MySQL) y landing-pages (app Koa con las landings, /admin y el bot de WhatsApp).",
  "engines": {
    "node": ">=24.22.1"
  },
  "workspaces": [
    "packages/core",
    "packages/contracts",
    "packages/db",
    "landing-pages"
  ],
  "scripts": {
    "start": "npm run start -w landing-pages --",
    "dev": "npm run dev -w landing-pages --",
    "build:css": "npm run build:css -w landing-pages --",
    "watch:css": "npm run watch:css -w landing-pages --",
    "test": "npm run test -w landing-pages --",
    "test:watch": "npm run test:watch -w landing-pages --",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p tsconfig.json",
    "db:generate": "npm run db:generate -w @restaurante/db --",
    "db:up": "docker compose up -d --wait mysql-dev",
    "db:down": "docker compose stop mysql-dev",
    "db:migrate": "npm run db:migrate -w @restaurante/db --",
    "db:migrate:dev": "npm run db:migrate:dev -w @restaurante/db --",
    "admin:hash-password": "npm run admin:hash-password -w landing-pages --",
    "admin:recover": "npm run admin:recover -w landing-pages --",
    "bot:chat": "npm run bot:chat -w landing-pages --",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "audit:deps": "npm run audit:deps -w landing-pages --"
  },
  "allowScripts": {
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true,
    "@parcel/watcher": false,
    "fsevents": false
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0"
  }
}
