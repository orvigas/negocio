// Esquema de la base de datos (REQ-F-007, REQ-F-008 y REQ-F-014): MySQL 8.4 en utf8mb4 con la
// colación utf8mb4_es_0900_as_cs en la base, las tablas y las columnas.
// - El cliente se genera en src/generated/prisma (`npm run db:generate`; no se versiona).
// - Cada texto lleva su longitud explícita (@db.VarChar con el máximo que permite la validación de
//   la app, que también cuenta puntos de código) o @db.MediumText.
// - Las migraciones se crean con `npm run db:migrate:dev -- --name <nombre>` y se REVISAN A MANO:
//   Prisma escribe `COLLATE utf8mb4_unicode_ci` en cada CREATE TABLE y hay que cambiarlo por
//   utf8mb4_es_0900_as_cs (tests/unit/migrations-collation.test.ts lo comprueba).
// - Las aplica el proceso aparte `migrate` (prisma migrate deploy, usuario con DDL); la app solo
//   verifica el estado al arrancar (src/db/verify.ts).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "ts"
  runtime             = "nodejs"
}

datasource db {
  provider = "mysql"
}

/// Rol de un usuario de /admin (D-2). `gerente` (REQ-F-049): solo el inventario; va al final del ENUM.
enum Role {
  admin
  editor
  gerente
}

/// Negocios (mismos ids que src/config/businesses.ts).
enum Business {
  molotes
  birria
}

/// Cuenta personal de la administración (D-10). No se elimina: se desactiva (D-6).
model User {
  id                 Int                      @id @default(autoincrement())
  /// Usuario de acceso tal como se escribió.
  username           String                   @db.VarChar(60)
  /// Usuario normalizado (NFC y minúsculas): único sin distinguir mayúsculas.
  /// Hasta 120 puntos de código: toLowerCase() convierte «İ» en dos.
  usernameKey        String                   @unique @map("username_key") @db.VarChar(128)
  displayName        String                   @map("display_name") @db.VarChar(60)
  role               Role
  active             Boolean                  @default(true)
  /// scrypt$N$r$p$sal$hash (sal ≤ 64 bytes; ver services/admin-auth.ts).
  passwordHash       String                   @map("password_hash") @db.VarChar(255)
  /// Cambia al desactivar, cambiar rol/negocios o contraseña: invalida las sesiones abiertas (D-8).
  sessionVersion     Int                      @default(0) @map("session_version")
  createdAt          DateTime                 @default(now()) @map("created_at")
  updatedAt          DateTime                 @updatedAt @map("updated_at")
  lastLoginAt        DateTime?                @map("last_login_at")
  businesses         UserBusiness[]
  auditActions       UserAudit[]              @relation("actor")
  auditEvents        UserAudit[]              @relation("target")
  productChanges     ProductChange[]
  botBlocksAdded     BotBlock[]               @relation("blockCreator")
  botBlocksRemoved   BotBlock[]               @relation("blockRemover")
  botAudits          BotAudit[]
  botControls        BotControl[]
  inventoryChanges   InventoryChange[]
  recipeVersions     InventoryRecipeVersion[]
  inventoryDocuments InventoryDocument[]
  inventoryMovements InventoryMovement[]

  @@map("user")
}

/// Negocios asignados a un editor (el administrador los tiene todos de forma implícita).
model UserBusiness {
  userId   Int      @map("user_id")
  business Business
  user     User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([userId, business])
  @@map("user_business")
}

/// Registro de la gestión de usuarios (D-12). Nunca guarda contraseñas ni hashes.
model UserAudit {
  id        Int      @id @default(autoincrement())
  at        DateTime @default(now())
  action    String   @db.VarChar(32)
  /// Usuario que hizo la acción; null si fue la consola o el sistema.
  actorId   Int?     @map("actor_id")
  /// user | console | system
  actorKind String   @map("actor_kind") @db.VarChar(16)
  targetId  Int      @map("target_id")
  /// JSON con los campos cambiados (antes/después), sin contraseñas ni hashes.
  changes   String?  @db.MediumText
  actor     User?    @relation("actor", fields: [actorId], references: [id], onDelete: Restrict)
  target    User     @relation("target", fields: [targetId], references: [id], onDelete: Restrict)

  @@index([targetId])
  @@map("user_audit")
}

/// Categoría de un producto (REQ-F-008, RF-1). Birria solo tiene platillos.
enum ProductCategory {
  platillo
  bebida
}

/// Bloque de detalle de un platillo de Birria (D-14: no se cambia después de crearlo).
enum DetailsType {
  chips
  portion
  variants
}

/// Producto de una landing (REQ-F-008, D-3): campos comunes y columnas opcionales por negocio y
/// categoría (las reglas viven en src/services/product-schema.ts). No se borra: se marca como
/// eliminado (D-4). El slug no se edita ni se reutiliza, aunque el producto esté eliminado (D-16).
model Product {
  id              Int              @id @default(autoincrement())
  business        Business
  category        ProductCategory
  slug            String           @db.VarChar(64)
  name            String           @db.VarChar(80)
  description     String?          @db.VarChar(400)
  /// Badge (Molotes) o tag (Birria).
  label           String?          @db.VarChar(40)
  priceCents      Int?             @map("price_cents")
  priceUnit       String?          @map("price_unit") @db.VarChar(40)
  available       Boolean          @default(false)
  /// Orden dentro de su negocio y categoría (1 = primero), entre los no eliminados.
  position        Int
  imageSrc        String?          @map("image_src") @db.VarChar(255)
  imageAlt        String?          @map("image_alt") @db.VarChar(150)
  imageWidth      Int?             @map("image_width")
  imageHeight     Int?             @map("image_height")
  tone            String?          @db.VarChar(20)
  orderPriceCents Int?             @map("order_price_cents")
  orderQuantity   Int?             @map("order_quantity")
  icon            String?          @db.VarChar(40)
  detailsType     DetailsType?     @map("details_type")
  detailsLabel    String?          @map("details_label") @db.VarChar(40)
  portion         String?          @db.VarChar(40)
  portionExtra    String?          @map("portion_extra") @db.VarChar(40)
  /// Aumenta con cada escritura (control de concurrencia, D-7′).
  version         Int              @default(1)
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @map("updated_at")
  deleted         Boolean          @default(false)
  deletedAt       DateTime?        @map("deleted_at")
  variants        ProductVariant[]
  chips           ProductChip[]
  changes         ProductChange[]

  @@unique([business, slug])
  @@index([business, category, deleted, position])
  @@map("product")
}

/// Variante de un platillo de Birria con detalle `variants` (1 a 6, D-13).
model ProductVariant {
  id          Int     @id @default(autoincrement())
  productId   Int     @map("product_id")
  position    Int
  label       String  @db.VarChar(40)
  priceCents  Int     @map("price_cents")
  description String  @db.VarChar(400)
  available   Boolean
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, position])
  @@map("product_variant")
}

/// Chip de un platillo de Birria con detalle `chips` (1 a 6, D-13).
model ProductChip {
  id        Int     @id @default(autoincrement())
  productId Int     @map("product_id")
  position  Int
  text      String  @db.VarChar(40)
  highlight Boolean
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, position])
  @@map("product_chip")
}

/// Registro de cambios de productos (RF-8.3), escrito en la misma transacción que el cambio.
model ProductChange {
  id        Int      @id @default(autoincrement())
  at        DateTime
  business  Business
  productId Int      @map("product_id")
  slug      String   @db.VarChar(64)
  /// create | update | delete | restore | reorder | overwrite_after_conflict | import
  action    String   @db.VarChar(32)
  /// Usuario autenticado; null si fue el sistema (importación).
  actorId   Int?     @map("actor_id")
  /// Nombre visible en el momento del cambio (D-20).
  actorName String   @map("actor_name") @db.VarChar(60)
  /// JSON: [{ field, before, after }].
  changes   String   @db.MediumText
  product   Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([business, at])
  @@index([productId])
  @@map("product_change")
}

/// Importación única de los productos de un negocio (D-8, RN-6).
model ProductImport {
  business   Business @id
  importedAt DateTime @map("imported_at")
  /// current | previous | seed
  source     String   @db.VarChar(16)
  count      Int

  @@map("product_import")
}

/// Origen de un bloqueo del bot (REQ-F-025, RF-3.2).
enum BotBlockOrigin {
  manual
  tope
  repeticion
}

/// Lista negra del bot (REQ-F-025, RF-3; D-1): una fila por bloqueo, con historial para el escalón
/// (RF-7.2). Nunca guarda el número completo: un HMAC-SHA256 con una clave que no está en la base
/// (D-T1) y los 4 últimos dígitos.
model BotBlock {
  id              Int            @id @default(autoincrement())
  /// HMAC-SHA256 (hex) del número canónico (52 + 10 en México; CA-9).
  phoneHash       String         @map("phone_hash") @db.Char(64)
  /// Identificador de la clave con la que se calculó (rotación, D-T1).
  keyId           String         @map("key_id") @db.Char(8)
  last4           String         @db.Char(4)
  origin          BotBlockOrigin
  reason          String?        @db.VarChar(200)
  createdAt       DateTime       @map("created_at")
  /// null: permanente.
  expiresAt       DateTime?      @map("expires_at")
  /// null: el sistema (bloqueo automático).
  createdById     Int?           @map("created_by_id")
  createdByName   String?        @map("created_by_name") @db.VarChar(60)
  removedAt       DateTime?      @map("removed_at")
  removedById     Int?           @map("removed_by_id")
  removedByName   String?        @map("removed_by_name") @db.VarChar(60)
  /// Caducidad ya registrada en la auditoría (RF-3.7).
  expiryAuditedAt DateTime?      @map("expiry_audited_at")
  createdBy       User?          @relation("blockCreator", fields: [createdById], references: [id], onDelete: Restrict)
  removedBy       User?          @relation("blockRemover", fields: [removedById], references: [id], onDelete: Restrict)

  @@index([phoneHash])
  @@index([expiresAt])
  @@index([createdAt])
  @@map("bot_block")
}

/// Auditoría del bot (REQ-F-025, RF-3.7 y RF-9.1): solo números enmascarados; se conserva 12 meses.
model BotAudit {
  id        Int      @id @default(autoincrement())
  at        DateTime
  /// block_added | block_removed | block_expired | bot_paused | bot_resumed
  action    String   @db.VarChar(32)
  /// null: el sistema.
  actorId   Int?     @map("actor_id")
  /// user | system
  actorKind String   @map("actor_kind") @db.VarChar(16)
  actorName String?  @map("actor_name") @db.VarChar(60)
  /// Número enmascarado (maskPhone), nunca el completo.
  masked    String?  @db.VarChar(20)
  origin    String?  @db.VarChar(16)
  reason    String?  @db.VarChar(200)
  /// Duración o caducidad del bloqueo.
  details   String?  @db.VarChar(200)
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([at])
  @@map("bot_audit")
}

/// Contadores globales del bot por día y por mes en la zona del negocio (REQ-F-025, RF-2). Sin
/// datos personales.
model BotUsage {
  /// day | month
  periodType        String    @map("period_type") @db.VarChar(8)
  /// AAAA-MM-DD o AAAA-MM.
  period            String    @db.VarChar(10)
  templates         Int       @default(0)
  outbound          Int       @default(0)
  templatesCappedAt DateTime? @map("templates_capped_at")
  outboundCappedAt  DateTime? @map("outbound_capped_at")
  budgetCappedAt    DateTime? @map("budget_capped_at")
  updatedAt         DateTime  @map("updated_at")

  @@id([periodType, period])
  @@map("bot_usage")
}

/// Interruptor de emergencia del bot (REQ-F-025, RF-9): una sola fila (id = 1). Sin fila, el bot no
/// está pausado.
model BotControl {
  id            Int      @id
  paused        Boolean
  changedAt     DateTime @map("changed_at")
  changedById   Int?     @map("changed_by_id")
  changedByName String?  @map("changed_by_name") @db.VarChar(60)
  reason        String?  @db.VarChar(200)
  changedBy     User?    @relation(fields: [changedById], references: [id], onDelete: Restrict)

  @@map("bot_control")
}

// --- Datos de página (REQ-F-044) -------------------------------------------------------------

enum PageSlot {
  current
  previous
}

/// Versión vigente y anterior de los datos de página de un negocio (RN-3). Las fechas son texto:
/// conservan el desplazamiento y mantienen `revision@updatedAt`, el control de versión de los JSON.
model PageVersion {
  business    Business
  slot        PageSlot
  revision    Int
  updatedAt   String?  @map("updated_at") @db.VarChar(64)
  /// Nombre visible en el momento del cambio; null en la semilla.
  updatedBy   String?  @map("updated_by") @db.VarChar(60)
  /// Sin clave foránea: los documentos importados no traen id de autor.
  updatedById Int?     @map("updated_by_id")
  /// JSON de los datos de página.
  data        String   @db.MediumText

  @@id([business, slot])
  @@map("page_version")
}

/// Historial de la página (RF-8), escrito en la misma transacción que el cambio.
model PageChange {
  id       Int      @id @default(autoincrement())
  at       String?  @db.VarChar(64)
  business Business
  /// Nombre visible en el momento del cambio.
  author   String   @db.VarChar(60)
  /// Sin clave foránea: un id histórico de `changes.jsonl` no debe impedir la importación.
  authorId Int?     @map("author_id")
  /// save | overwrite_after_conflict | restore_previous | restore_seed (esta, solo importada)
  action   String   @db.VarChar(32)
  /// JSON: [{ field, before, after }].
  changes  String   @db.MediumText
  /// Viene de `changes.jsonl`.
  imported Boolean  @default(false)

  @@index([business, id])
  @@map("page_change")
}

/// Importación única de los datos de página de un negocio (RF-2). Viaja con los volcados.
model PageImport {
  business      Business @id
  importedAt    DateTime @map("imported_at")
  /// current | previous | seed
  source        String   @db.VarChar(16)
  /// `revision@updatedAt` del documento importado: delata un JSON editado después (CA-16).
  sourceVersion String   @map("source_version") @db.VarChar(96)
  historyCount  Int      @map("history_count")
  skippedLines  Int      @map("skipped_lines")

  @@map("page_import")
}

// --- Inventario: catálogo de artículos (REQ-F-049, T1) ----------------------------------------
// Catálogo aparte del menú (D-2), compartido por los dos negocios (D-3: sin columna de negocio).
// Factores en DECIMAL exacto (PV-13), nunca FLOAT ni DOUBLE: core los maneja como bigint escalados
// (packages/core/inventory/decimal.ts) y el store los escribe como texto.

/// Tipo de artículo (RN-1). No cambia después de crearlo.
enum InventoryItemType {
  insumo
  intermedio
  compuesto
  reventa
}

/// simple: artículo normal; parent: agrupa variantes (sin unidad base, SKU ni empaques);
/// variant: hija de un parent (un solo nivel). No cambia después de crearlo.
enum InventoryItemKind {
  simple
  parent
  variant
}

/// Unidades del sistema (RN-3): kg y g (masa), L y ml (volumen), pza (pieza) y hr (tiempo, sin
/// conversión a otras; REQ-F-050). Un valor nuevo siempre va al final (ALTER INSTANT, sin reconstruir).
enum InventoryUnit {
  kg
  g
  L
  ml
  pza
  hr
}

/// Categoría administrable del catálogo (RF-6). No se borra: se inactiva.
model InventoryCategory {
  id            Int             @id @default(autoincrement())
  name          String          @db.VarChar(60)
  /// Nombre normalizado (NFC y minúsculas). Hasta 120: toLowerCase() puede alargar el texto.
  nameKey       String          @map("name_key") @db.VarChar(120)
  /// = nameKey si está activa; null si no. Único: nombre único entre las activas.
  activeNameKey String?         @unique @map("active_name_key") @db.VarChar(120)
  active        Boolean         @default(true)
  createdAt     DateTime        @map("created_at")
  updatedAt     DateTime        @map("updated_at")
  items         InventoryItem[]

  @@map("inventory_category")
}

/// Artículo del inventario (RF-2 y RF-5). No se borra: se inactiva (RN-2, PV-11).
model InventoryItem {
  id             Int                      @id @default(autoincrement())
  kind           InventoryItemKind
  type           InventoryItemType
  parentId       Int?                     @map("parent_id")
  categoryId     Int                      @map("category_id")
  name           String                   @db.VarChar(80)
  /// Nombre normalizado (NFC y minúsculas). Hasta 160: toLowerCase() puede alargar el texto.
  nameKey        String                   @map("name_key") @db.VarChar(160)
  /// = nameKey si está activo; null si no (RF-2: único entre los activos, sin distinguir mayúsculas).
  activeNameKey  String?                  @unique @map("active_name_key") @db.VarChar(160)
  description    String?                  @db.VarChar(400)
  /// SKU vigente tal como se escribió (su unicidad la impone inventory_sku; PV-14).
  sku            String?                  @db.VarChar(40)
  /// null solo en un parent.
  baseUnit       InventoryUnit?           @map("base_unit")
  active         Boolean                  @default(true)
  /// Aumenta con cada escritura (control de concurrencia, RF-8).
  version        Int                      @default(1)
  createdAt      DateTime                 @map("created_at")
  updatedAt      DateTime                 @map("updated_at")
  /// Autor de la última escritura (aviso de conflicto). Sin clave foránea, como page_version.
  updatedById    Int?                     @map("updated_by_id")
  updatedByName  String?                  @map("updated_by_name") @db.VarChar(60)
  /// Costo de referencia por unidad base, en MXN con IVA (REQ-F-050, C-1 y RN-T2-6). null: sin costo.
  referenceCost  Decimal?                 @map("reference_cost") @db.Decimal(15, 4)
  /// false: no lleva existencias; se costea siempre por su referencia (REQ-F-050, C-3 y RN-T2-5).
  inventoriable  Boolean                  @default(true)
  parent         InventoryItem?           @relation("variants", fields: [parentId], references: [id], onDelete: Restrict)
  variants       InventoryItem[]          @relation("variants")
  category       InventoryCategory        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  units          InventoryItemUnit[]
  skus           InventorySku[]
  recipeVersions InventoryRecipeVersion[] @relation("recipeVersions")
  currentRecipe  InventoryRecipeVersion?  @relation("currentRecipe")
  usedInLines    InventoryRecipeLine[]
  stock          InventoryStock?
  movements      InventoryMovement[]

  @@index([active, type])
  @@index([categoryId, active])
  @@index([parentId])
  @@map("inventory_item")
}

/// Unidad de empaque propia del artículo (RF-3): factor > 0 hacia la unidad base.
model InventoryItemUnit {
  id       Int           @id @default(autoincrement())
  itemId   Int           @map("item_id")
  /// Orden dentro del artículo (1 = primero).
  position Int
  name     String        @db.VarChar(30)
  /// Nombre normalizado (NFC y minúsculas): único dentro del artículo.
  nameKey  String        @map("name_key") @db.VarChar(60)
  /// Unidades base que contiene (la columna admite hasta 9 999 999 999.999; core, hasta 1 000 000).
  factor   Decimal       @db.Decimal(13, 3)
  item     InventoryItem @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@unique([itemId, nameKey])
  @@unique([itemId, position])
  @@map("inventory_item_unit")
}

/// Registro de todo SKU asignado alguna vez (PV-14 y DT-3): único entre activos e inactivos y no
/// reutilizable, aunque el artículo cambie de SKU.
model InventorySku {
  /// SKU en mayúsculas.
  skuKey     String        @id @map("sku_key") @db.VarChar(40)
  itemId     Int           @map("item_id")
  assignedAt DateTime      @map("assigned_at")
  item       InventoryItem @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@index([itemId])
  @@map("inventory_sku")
}

/// Historial del catálogo (RN-16), escrito en la misma transacción que el cambio.
model InventoryChange {
  id        Int      @id @default(autoincrement())
  at        DateTime
  /// item | category | recipe (REQ-F-050: entityId = artículo producido)
  entity    String   @db.VarChar(16)
  entityId  Int      @map("entity_id")
  /// create | update | overwrite_after_conflict | deactivate | reactivate | inherit;
  /// recetas: new_version | close
  action    String   @db.VarChar(32)
  /// Usuario autenticado; null si fue el sistema (semilla de desarrollo).
  actorId   Int?     @map("actor_id")
  /// Nombre visible en el momento del cambio.
  actorName String   @map("actor_name") @db.VarChar(60)
  /// JSON: [{ field, before, after }].
  changes   String   @db.MediumText
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([entity, entityId, id])
  @@map("inventory_change")
}

// --- Inventario: recetas multinivel versionadas (REQ-F-050, T2) ---------------------------------
// Una versión es inmutable: solo se cierra (valid_to y current_item_id). Cantidades DECIMAL(13,3) y
// merma DECIMAL(5,2) exactas (PV-13); el costo teórico se calcula al consultar, nunca se guarda.

/// Versión de la receta de un artículo Intermedio o Compuesto (RN-T2-2, RF-4).
model InventoryRecipeVersion {
  id            Int                   @id @default(autoincrement())
  itemId        Int                   @map("item_id")
  /// 1, 2, 3… por artículo (máximo + 1 dentro del candado `recetas`).
  number        Int
  /// Rendimiento en la unidad base del artículo producido (> 0).
  yieldQuantity Decimal               @map("yield_quantity") @db.Decimal(13, 3)
  validFrom     DateTime              @map("valid_from")
  /// null mientras está vigente.
  validTo       DateTime?             @map("valid_to")
  /// = item_id mientras está vigente; null al cerrarse. Único: una sola vigente por artículo.
  currentItemId Int?                  @unique @map("current_item_id")
  note          String?               @db.VarChar(400)
  createdAt     DateTime              @map("created_at")
  /// null: importación o semilla.
  createdById   Int?                  @map("created_by_id")
  createdByName String                @map("created_by_name") @db.VarChar(60)
  item          InventoryItem         @relation("recipeVersions", fields: [itemId], references: [id], onDelete: Restrict)
  currentItem   InventoryItem?        @relation("currentRecipe", fields: [currentItemId], references: [id], onDelete: Restrict)
  createdBy     User?                 @relation(fields: [createdById], references: [id], onDelete: Restrict)
  lines         InventoryRecipeLine[]

  @@unique([itemId, number])
  @@index([itemId, validFrom])
  @@map("inventory_recipe_version")
}

/// Línea de una versión (RF-3, RN-6): neta en la unidad capturada y en la base, merma y bruta.
model InventoryRecipeLine {
  id                Int                    @id @default(autoincrement())
  versionId         Int                    @map("version_id")
  /// 1..40
  position          Int
  ingredientItemId  Int                    @map("ingredient_item_id")
  /// Cantidad neta (aprovechable tras la merma) en `unit`.
  quantity          Decimal                @db.Decimal(13, 3)
  /// Unidad del sistema o empaque del ingrediente, tal como quedó normalizada.
  unit              String                 @db.VarChar(30)
  netBaseQuantity   Decimal                @map("net_base_quantity") @db.Decimal(13, 3)
  /// Merma en % [0, 100).
  wastePercent      Decimal                @map("waste_percent") @db.Decimal(5, 2)
  /// neta / (1 − merma), en la unidad base del ingrediente.
  grossBaseQuantity Decimal                @map("gross_base_quantity") @db.Decimal(13, 3)
  note              String?                @db.VarChar(200)
  version           InventoryRecipeVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)
  ingredient        InventoryItem          @relation(fields: [ingredientItemId], references: [id], onDelete: Restrict)

  @@unique([versionId, position])
  @@unique([versionId, ingredientItemId])
  @@index([ingredientItemId])
  @@map("inventory_recipe_line")
}

/// Candados lógicos del inventario. La fila `recetas` serializa las escrituras de recetas y las de
/// artículos que consultan su uso (se toma con un upsert: funciona aunque falte la fila).
model InventoryLock {
  name String @id @db.VarChar(32)

  @@map("inventory_lock")
}

// --- Inventario: Kardex, existencias y proveedores (REQ-F-051, T3) -------------------------------
// Documentos y movimientos son inmutables (RN-T3-9, DT-5): solo se insertan. Los tipos, el criterio de
// costo y los motivos son VARCHAR con la lista cerrada en core (DT-T3-1 y DT-15): una imagen anterior
// lee un valor que no conoce sin fallar. Cantidades DECIMAL(13,3), costos DECIMAL(15,4) e importes
// DECIMAL(19,4) exactos (PV-13).

/// Proveedor (RF-1). No se borra: se inactiva. Del proveedor solo se guardan el nombre y un contacto (PV-7).
model InventorySupplier {
  id            Int                 @id @default(autoincrement())
  name          String              @db.VarChar(80)
  /// Nombre normalizado (NFC y minúsculas).
  nameKey       String              @map("name_key") @db.VarChar(160)
  /// = nameKey si está activo; null si no (único entre los activos, sin distinguir mayúsculas).
  activeNameKey String?             @unique @map("active_name_key") @db.VarChar(160)
  /// Un teléfono o un correo, nada más (PV-7).
  contact       String?             @db.VarChar(120)
  active        Boolean             @default(true)
  /// Aumenta con cada escritura (control de concurrencia).
  version       Int                 @default(1)
  createdAt     DateTime            @map("created_at")
  updatedAt     DateTime            @map("updated_at")
  /// Autor de la última escritura (aviso de conflicto). Sin clave foránea, como el artículo.
  updatedById   Int?                @map("updated_by_id")
  updatedByName String?             @map("updated_by_name") @db.VarChar(60)
  documents     InventoryDocument[]

  @@map("inventory_supplier")
}

/// Existencia de un artículo: proyección mutable del Kardex (DT-T3-2). Una fila por artículo que no es
/// padre; RN-T3-1 decide cuáles se muestran y cuáles admiten movimientos.
model InventoryStock {
  itemId    Int           @id @map("item_id")
  /// En la unidad base, con signo (PV-2 permite negativos).
  quantity  Decimal       @default(0) @db.Decimal(13, 3)
  /// CPP por unidad base; null = sin costo.
  avgCost   Decimal?      @map("avg_cost") @db.Decimal(15, 4)
  /// Costo por unidad base de la última compra no revertida (DT-T3-4); null si no hay.
  lastCost  Decimal?      @map("last_cost") @db.Decimal(15, 4)
  /// `seq` del último movimiento del artículo (0: sin movimientos).
  lastSeq   Int           @default(0) @map("last_seq")
  updatedAt DateTime      @map("updated_at")
  item      InventoryItem @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@map("inventory_stock")
}

/// Documento del Kardex (cabecera, RN-T3-2): saldo inicial, compra, devolución, ajuste o reversión.
model InventoryDocument {
  id                 Int                 @id @default(autoincrement())
  /// Tipo de la lista cerrada de core (DT-T3-1).
  type               String              @db.VarChar(24)
  /// Fecha del hecho en BUSINESS_TIMEZONE (RN-T3-3): informativa.
  occurredOn         DateTime            @map("occurred_on") @db.Date
  recordedAt         DateTime            @map("recorded_at")
  supplierId         Int?                @map("supplier_id")
  /// Folio de la factura o nota.
  reference          String?             @db.VarChar(40)
  /// Compras: criterio del costo (PV-6, PV-T3-11), de la lista de core.
  costBasis          String?             @map("cost_basis") @db.VarChar(16)
  /// Ajustes: motivo de la lista cerrada de core (DT-15).
  reason             String?             @db.VarChar(32)
  /// Nota; en una reversión, el motivo obligatorio (PV-T3-8).
  note               String?             @db.VarChar(400)
  totalCost          Decimal             @map("total_cost") @db.Decimal(19, 4)
  /// Documento que revierte (único: una reversión por documento).
  reversesDocumentId Int?                @unique @map("reverses_document_id")
  /// Devolución: la compra de la que sale (RF-6).
  sourceDocumentId   Int?                @map("source_document_id")
  /// `<actorId>:<tipo>:<requestId>` (DT-14).
  idempotencyKey     String?             @unique @map("idempotency_key") @db.VarChar(120)
  /// sha256 del cuerpo canónico: distingue un reenvío de otra petición con la misma clave.
  requestHash        String?             @map("request_hash") @db.Char(64)
  actorId            Int?                @map("actor_id")
  actorName          String              @map("actor_name") @db.VarChar(60)
  supplier           InventorySupplier?  @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  reverses           InventoryDocument?  @relation("reversal", fields: [reversesDocumentId], references: [id], onDelete: Restrict)
  reversedBy         InventoryDocument?  @relation("reversal")
  source             InventoryDocument?  @relation("returns", fields: [sourceDocumentId], references: [id], onDelete: Restrict)
  returns            InventoryDocument[] @relation("returns")
  actor              User?               @relation(fields: [actorId], references: [id], onDelete: Restrict)
  movements          InventoryMovement[]

  @@index([type, id])
  @@index([supplierId, id])
  @@index([sourceDocumentId])
  @@map("inventory_document")
}

/// Movimiento del Kardex (RN-8, RN-T3-2): solo altas; `seq` contiguo por artículo.
model InventoryMovement {
  id               Int                 @id @default(autoincrement())
  documentId       Int                 @map("document_id")
  /// 1..50 dentro del documento.
  line             Int
  itemId           Int                 @map("item_id")
  /// 1, 2, 3… por artículo, sin huecos.
  seq              Int
  type             String              @db.VarChar(24)
  /// En la unidad base, con signo (+ entrada, − salida), distinta de 0.
  quantity         Decimal             @db.Decimal(13, 3)
  /// Cantidad y unidad tal como se capturaron.
  enteredQuantity  Decimal             @map("entered_quantity") @db.Decimal(13, 3)
  enteredUnit      String              @map("entered_unit") @db.VarChar(30)
  balanceBefore    Decimal             @map("balance_before") @db.Decimal(13, 3)
  balanceAfter     Decimal             @map("balance_after") @db.Decimal(13, 3)
  /// Costo aplicado por unidad base; null: sin costo.
  unitCost         Decimal?            @map("unit_cost") @db.Decimal(15, 4)
  /// Compra: importe capturado; resto: |cantidad| × costo.
  lineTotal        Decimal?            @map("line_total") @db.Decimal(19, 4)
  avgCostBefore    Decimal?            @map("avg_cost_before") @db.Decimal(15, 4)
  avgCostAfter     Decimal?            @map("avg_cost_after") @db.Decimal(15, 4)
  /// Reversión: el movimiento que revierte; devolución: la línea de compra.
  sourceMovementId Int?                @map("source_movement_id")
  recordedAt       DateTime            @map("recorded_at")
  actorId          Int?                @map("actor_id")
  actorName        String              @map("actor_name") @db.VarChar(60)
  document         InventoryDocument   @relation(fields: [documentId], references: [id], onDelete: Restrict)
  item             InventoryItem       @relation(fields: [itemId], references: [id], onDelete: Restrict)
  source           InventoryMovement?  @relation("movementSource", fields: [sourceMovementId], references: [id], onDelete: Restrict)
  derived          InventoryMovement[] @relation("movementSource")
  actor            User?               @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@unique([itemId, seq])
  @@unique([documentId, line])
  @@index([sourceMovementId])
  @@map("inventory_movement")
}
