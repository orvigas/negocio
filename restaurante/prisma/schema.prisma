// Esquema de la base de datos (REQ-F-007, REQ-F-008 y REQ-F-014): MySQL 8.4 en utf8mb4 con la
// colación utf8mb4_es_0900_as_cs en la base, las tablas y las columnas.
// - El cliente se genera en src/generated/prisma (`npm run db:generate`; no se versiona).
// - Cada texto lleva su longitud explícita (@db.VarChar con el máximo que permite la validación de
//   la app, que también cuenta puntos de código) o @db.MediumText.
// - Las migraciones se crean con `npm run db:migrate:dev -- --name <nombre>` y se REVISAN A MANO:
//   Prisma escribe `COLLATE utf8mb4_unicode_ci` en cada CREATE TABLE y hay que cambiarlo por
//   utf8mb4_es_0900_as_cs (tests/unit/migrations-collation.test.ts lo comprueba).
// - Las aplica el proceso aparte `migrate` (prisma migrate deploy, usuario con DDL); la app solo
//   verifica el estado al arrancar (src/db/verify.ts).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "ts"
  runtime             = "nodejs"
}

datasource db {
  provider = "mysql"
}

/// Rol de un usuario de /admin (D-2).
enum Role {
  admin
  editor
}

/// Negocios (mismos ids que src/config/businesses.ts).
enum Business {
  molotes
  birria
}

/// Cuenta personal de la administración (D-10). No se elimina: se desactiva (D-6).
model User {
  id             Int            @id @default(autoincrement())
  /// Usuario de acceso tal como se escribió.
  username       String         @db.VarChar(60)
  /// Usuario normalizado (NFC y minúsculas): único sin distinguir mayúsculas.
  /// Hasta 120 puntos de código: toLowerCase() convierte «İ» en dos.
  usernameKey    String         @unique @map("username_key") @db.VarChar(128)
  displayName    String         @map("display_name") @db.VarChar(60)
  role           Role
  active         Boolean        @default(true)
  /// scrypt$N$r$p$sal$hash (sal ≤ 64 bytes; ver services/admin-auth.ts).
  passwordHash   String         @map("password_hash") @db.VarChar(255)
  /// Cambia al desactivar, cambiar rol/negocios o contraseña: invalida las sesiones abiertas (D-8).
  sessionVersion Int            @default(0) @map("session_version")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  lastLoginAt    DateTime?      @map("last_login_at")
  businesses     UserBusiness[]
  auditActions   UserAudit[]    @relation("actor")
  auditEvents    UserAudit[]    @relation("target")
  productChanges ProductChange[]

  @@map("user")
}

/// Negocios asignados a un editor (el administrador los tiene todos de forma implícita).
model UserBusiness {
  userId   Int      @map("user_id")
  business Business
  user     User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([userId, business])
  @@map("user_business")
}

/// Registro de la gestión de usuarios (D-12). Nunca guarda contraseñas ni hashes.
model UserAudit {
  id        Int      @id @default(autoincrement())
  at        DateTime @default(now())
  action    String   @db.VarChar(32)
  /// Usuario que hizo la acción; null si fue la consola o el sistema.
  actorId   Int?     @map("actor_id")
  /// user | console | system
  actorKind String   @map("actor_kind") @db.VarChar(16)
  targetId  Int      @map("target_id")
  /// JSON con los campos cambiados (antes/después), sin contraseñas ni hashes.
  changes   String?  @db.MediumText
  actor     User?    @relation("actor", fields: [actorId], references: [id], onDelete: Restrict)
  target    User     @relation("target", fields: [targetId], references: [id], onDelete: Restrict)

  @@index([targetId])
  @@map("user_audit")
}

/// Categoría de un producto (REQ-F-008, RF-1). Birria solo tiene platillos.
enum ProductCategory {
  platillo
  bebida
}

/// Bloque de detalle de un platillo de Birria (D-14: no se cambia después de crearlo).
enum DetailsType {
  chips
  portion
  variants
}

/// Producto de una landing (REQ-F-008, D-3): campos comunes y columnas opcionales por negocio y
/// categoría (las reglas viven en src/services/product-schema.ts). No se borra: se marca como
/// eliminado (D-4). El slug no se edita ni se reutiliza, aunque el producto esté eliminado (D-16).
model Product {
  id              Int              @id @default(autoincrement())
  business        Business
  category        ProductCategory
  slug            String           @db.VarChar(64)
  name            String           @db.VarChar(80)
  description     String?          @db.VarChar(400)
  /// Badge (Molotes) o tag (Birria).
  label           String?          @db.VarChar(40)
  priceCents      Int?             @map("price_cents")
  priceUnit       String?          @map("price_unit") @db.VarChar(40)
  available       Boolean          @default(false)
  /// Orden dentro de su negocio y categoría (1 = primero), entre los no eliminados.
  position        Int
  imageSrc        String?          @map("image_src") @db.VarChar(255)
  imageAlt        String?          @map("image_alt") @db.VarChar(150)
  imageWidth      Int?             @map("image_width")
  imageHeight     Int?             @map("image_height")
  tone            String?          @db.VarChar(20)
  orderPriceCents Int?             @map("order_price_cents")
  orderQuantity   Int?             @map("order_quantity")
  icon            String?          @db.VarChar(40)
  detailsType     DetailsType?     @map("details_type")
  detailsLabel    String?          @map("details_label") @db.VarChar(40)
  portion         String?          @db.VarChar(40)
  portionExtra    String?          @map("portion_extra") @db.VarChar(40)
  /// Aumenta con cada escritura (control de concurrencia, D-7′).
  version         Int              @default(1)
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @map("updated_at")
  deleted         Boolean          @default(false)
  deletedAt       DateTime?        @map("deleted_at")
  variants        ProductVariant[]
  chips           ProductChip[]
  changes         ProductChange[]

  @@unique([business, slug])
  @@index([business, category, deleted, position])
  @@map("product")
}

/// Variante de un platillo de Birria con detalle `variants` (1 a 6, D-13).
model ProductVariant {
  id          Int     @id @default(autoincrement())
  productId   Int     @map("product_id")
  position    Int
  label       String  @db.VarChar(40)
  priceCents  Int     @map("price_cents")
  description String  @db.VarChar(400)
  available   Boolean
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, position])
  @@map("product_variant")
}

/// Chip de un platillo de Birria con detalle `chips` (1 a 6, D-13).
model ProductChip {
  id        Int     @id @default(autoincrement())
  productId Int     @map("product_id")
  position  Int
  text      String  @db.VarChar(40)
  highlight Boolean
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, position])
  @@map("product_chip")
}

/// Registro de cambios de productos (RF-8.3), escrito en la misma transacción que el cambio.
model ProductChange {
  id        Int      @id @default(autoincrement())
  at        DateTime
  business  Business
  productId Int      @map("product_id")
  slug      String   @db.VarChar(64)
  /// create | update | delete | restore | reorder | overwrite_after_conflict | import
  action    String   @db.VarChar(32)
  /// Usuario autenticado; null si fue el sistema (importación).
  actorId   Int?     @map("actor_id")
  /// Nombre visible en el momento del cambio (D-20).
  actorName String   @map("actor_name") @db.VarChar(60)
  /// JSON: [{ field, before, after }].
  changes   String   @db.MediumText
  product   Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([business, at])
  @@index([productId])
  @@map("product_change")
}

/// Importación única de los productos de un negocio (D-8, RN-6).
model ProductImport {
  business   Business @id
  importedAt DateTime @map("imported_at")
  /// current | previous | seed
  source     String   @db.VarChar(16)
  count      Int

  @@map("product_import")
}
